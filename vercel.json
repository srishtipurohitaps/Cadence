{
    "version": 2,
    "installCommand": "npm install --ignore-scripts=false",
    "buildCommand": "npm rebuild better-sqlite3 && node node_modules/typescript/bin/tsc",
    "functions": {
        "api/index.ts": {
            "includeFiles": "{pages,static}/**"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ]
}